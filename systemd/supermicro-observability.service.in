[Unit]
Description=Loopback-only Supermicro observability Compose stack
Documentation=file:@PROJECT_DIR@/README.md
Wants=docker.service
After=docker.service supermicro-fan-control.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
Environment=HOME=@SERVICE_HOME@
Environment=PATH=@CARGO_BIN_DIR@:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WorkingDirectory=@PROJECT_DIR@
ExecStart=@PROJECT_DIR@/scripts/monitoring-mode normal
ExecStop=@PROJECT_DIR@/scripts/monitoring-mode off
RemainAfterExit=yes
TimeoutStartSec=10min
TimeoutStopSec=2min
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
