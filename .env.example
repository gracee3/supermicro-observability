# Safe, non-deployable example. Use scripts/configure-host to generate .env.
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_RANDOM_64_HEX_CHARACTER_VALUE
GRAFANA_HTTP_ADDR=127.0.0.1
OBSERVABILITY_UID=1000
OBSERVABILITY_GID=1000
HOST_LABEL=localhost
PLATFORM_PROFILE=generic
ENABLE_NVIDIA_GPU=false
GPU_IDENTITY_MODE=alias
GPU_IDENTITY_SALT=REPLACE_WITH_A_RANDOM_LOCAL_ALIAS_SALT
ENABLE_SMART=false
SMART_DEVICE_HOST=
SMART_DEVICE_TYPE=auto
PROTECTED_DEVICE_PATHS=
REQUIRE_MAPPED_ROOT=false
FAN_METRICS_MODE=disabled
TEXTFILE_COLLECTOR_DIR=./runtime/textfile_collector
NODE_DISKSTATS_DEVICE_EXCLUDE=^(ram|loop|fd|sr|zram)[0-9]+$
