#!/usr/bin/env bash
set -Eeuo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
project_dir="$(cd -- "$script_dir/.." && pwd -P)"
host_config="$script_dir/host_config.py"
config_file="${OBSERVABILITY_CONFIG_FILE:-$project_dir/.env}"
compose=(docker compose --env-file "$config_file" --project-directory "$project_dir" --file "$project_dir/compose.yaml" --profile containers)

case "${1:-}" in
    on)
        python3 "$host_config" check --quiet
        "${compose[@]}" up -d cadvisor
        python3 "$host_config" targets cadvisor-on
        ;;
    off)
        python3 "$host_config" targets cadvisor-off
        "${compose[@]}" stop cadvisor
        ;;
    *)
        echo "usage: container-metrics on|off" >&2
        exit 2
        ;;
esac
