#!/usr/bin/env bash
set -Eeuo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
project_dir="$(cd -- "$script_dir/.." && pwd -P)"
target_file="$project_dir/prometheus/file_sd/cadvisor.json"
compose=(docker compose --project-directory "$project_dir" --file "$project_dir/compose.yaml" --profile containers)

write_targets() {
    local contents="$1" temp_file
    temp_file="$(mktemp "$target_file.XXXXXX")"
    printf '%s\n' "$contents" >"$temp_file"
    chmod 0644 "$temp_file"
    mv -f "$temp_file" "$target_file"
}

case "${1:-}" in
    on)
        "${compose[@]}" up -d cadvisor
        write_targets '[{"targets":["127.0.0.1:8080"],"labels":{"instance":"supermicro","collector_tier":"optional"}}]'
        ;;
    off)
        write_targets '[]'
        "${compose[@]}" stop cadvisor
        ;;
    *)
        echo "usage: container-metrics on|off" >&2
        exit 2
        ;;
esac
