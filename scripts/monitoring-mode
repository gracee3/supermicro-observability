#!/usr/bin/env bash
set -Eeuo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
project_dir="$(cd -- "$script_dir/.." && pwd -P)"
host_config="$script_dir/host_config.py"
config_file="${OBSERVABILITY_CONFIG_FILE:-$project_dir/.env}"
compose=(docker compose --env-file "$config_file" --project-directory "$project_dir" --file "$project_dir/compose.yaml")
all_profiles=(--profile nvidia --profile smart --profile containers)

usage() {
    echo "usage: monitoring-mode normal|benchmark|off" >&2
    exit 2
}

contains_service() {
    local wanted="$1" service
    shift
    for service in "$@"; do
        [[ "$service" == "$wanted" ]] && return 0
    done
    return 1
}

build_fast_exporter() {
    local build_root="${OBSERVABILITY_BUILD_DIR:-$project_dir/gpu-exporter}"
    local binary="$build_root/target/x86_64-unknown-linux-musl/release/supermicro-gpu-exporter"
    local rebuild=0
    if ! rustup target list --installed | grep -qx x86_64-unknown-linux-musl; then
        rustup target add x86_64-unknown-linux-musl
        rebuild=1
    fi
    if [[ ! -x "$binary" ]] || \
        find "$project_dir/gpu-exporter/src" "$project_dir/gpu-exporter/Cargo.toml" \
            -type f -newer "$binary" -print -quit | grep -q .; then
        rebuild=1
    fi
    if (( rebuild )); then
        CARGO_TARGET_DIR="$build_root/target" cargo build \
            --quiet \
            --release \
            --target x86_64-unknown-linux-musl \
            --manifest-path "$project_dir/gpu-exporter/Cargo.toml"
    fi
    if (( rebuild )) || ! docker image inspect local/supermicro-gpu-exporter:0.3.0 >/dev/null 2>&1; then
        "${compose[@]}" --profile nvidia build --quiet fast-gpu-exporter
    fi
}

stop_disabled_normal_services() {
    local -a selected=("$@") disabled=()
    local optional
    for optional in fast-gpu-exporter nvml-exporter smartctl-exporter; do
        contains_service "$optional" "${selected[@]}" || disabled+=("$optional")
    done
    (( ${#disabled[@]} == 0 )) || "${compose[@]}" "${all_profiles[@]}" stop "${disabled[@]}"
}

reload_prometheus() {
    for _ in {1..30}; do
        if curl --fail --silent --show-error --request POST \
            http://127.0.0.1:9090/-/reload >/dev/null 2>&1; then
            return 0
        fi
        sleep 1
    done
    echo "Prometheus did not accept a configuration reload within 30 seconds" >&2
    return 1
}

mode="${1:-}"
case "$mode" in
    normal)
        python3 "$host_config" check --quiet
        python3 "$host_config" targets normal
        mapfile -t services < <(python3 "$host_config" services normal)
        contains_service fast-gpu-exporter "${services[@]}" && build_fast_exporter
        stop_disabled_normal_services "${services[@]}"
        "${compose[@]}" "${all_profiles[@]}" up -d "${services[@]}"
        reload_prometheus
        ;;
    benchmark)
        python3 "$host_config" check --quiet
        python3 "$host_config" targets benchmark
        mapfile -t services < <(python3 "$host_config" services benchmark)
        contains_service fast-gpu-exporter "${services[@]}" && build_fast_exporter
        "${compose[@]}" "${all_profiles[@]}" stop grafana nvml-exporter smartctl-exporter cadvisor
        "${compose[@]}" "${all_profiles[@]}" up -d "${services[@]}"
        reload_prometheus
        ;;
    off)
        python3 "$host_config" targets off || true
        "${compose[@]}" "${all_profiles[@]}" stop
        ;;
    *)
        usage
        ;;
esac
