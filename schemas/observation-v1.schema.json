{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gracee3/supermicro-observability/schemas/observation-v1.schema.json",
  "title": "Supermicro observability agent response v1",
  "type": "object",
  "required": [
    "schema_version",
    "command",
    "generated_at",
    "status",
    "source",
    "metrics",
    "warnings"
  ],
  "properties": {
    "schema_version": {"const": "observation-v1"},
    "command": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["ok", "partial", "unavailable", "error"]},
    "profile": {"enum": ["system", "gpu", "thermal", "health", "benchmark"]},
    "source": {
      "type": "object",
      "required": ["type", "endpoint"],
      "properties": {
        "type": {"const": "prometheus"},
        "endpoint": {"const": "http://127.0.0.1:9090"}
      },
      "additionalProperties": false
    },
    "window": {
      "type": "object",
      "required": ["start", "end", "seconds", "query_step_seconds"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"},
        "seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 86400},
        "query_step_seconds": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "array",
      "items": {"$ref": "#/$defs/metric"}
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "error": {"$ref": "#/$defs/error"},
    "session": {
      "type": "object",
      "properties": {
        "token": {"type": "string"},
        "label": {"type": "string", "maxLength": 64},
        "metadata": {
          "type": "object",
          "maxProperties": 16,
          "additionalProperties": {"type": "string", "maxLength": 128}
        },
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"}
      },
      "required": ["label", "metadata", "started_at"],
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "dimensions": {
      "type": "object",
      "propertyNames": {"enum": ["gpu", "job", "reason"]},
      "additionalProperties": {"type": "string", "maxLength": 128}
    },
    "point": {
      "type": "object",
      "required": ["at", "value"],
      "properties": {
        "at": {"type": "string", "format": "date-time"},
        "value": {"type": "number"}
      },
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "required": ["id", "unit", "dimensions", "availability"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.]+$"},
        "unit": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
        "dimensions": {"$ref": "#/$defs/dimensions"},
        "dimension_keys": {
          "type": "array",
          "items": {"enum": ["gpu", "job", "reason"]},
          "uniqueItems": true
        },
        "availability": {"enum": ["available", "enabled", "disabled", "missing", "stale", "partial", "error"]},
        "value": {"type": "number"},
        "summary": {
          "type": "object",
          "required": ["min", "mean", "p95", "max", "points", "coverage"],
          "properties": {
            "min": {"type": "number"},
            "mean": {"type": "number"},
            "p95": {"type": "number"},
            "max": {"type": "number"},
            "points": {"type": "integer", "minimum": 1, "maximum": 600},
            "coverage": {"type": "number", "minimum": 0, "maximum": 1}
          },
          "additionalProperties": false
        },
        "series": {
          "type": "array",
          "maxItems": 120,
          "items": {"$ref": "#/$defs/point"}
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"availability": {"const": "available"}}},
          "then": {"anyOf": [{"required": ["value"]}, {"required": ["summary"]}]}
        }
      ]
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"},
        "remediation": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
