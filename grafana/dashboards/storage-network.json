            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "rate(node_disk_read_time_seconds_total{job=\"node-fast\"}[1m]) / clamp_min(rate(node_disk_reads_completed_total{job=\"node-fast\"}[1m]), 0.001)",
          "legendFormat": "{{device}} read",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "rate(node_disk_write_time_seconds_total{job=\"node-fast\"}[1m]) / clamp_min(rate(node_disk_writes_completed_total{job=\"node-fast\"}[1m]), 0.001)",
          "legendFormat": "{{device}} write",
          "range": true,
          "refId": "B"
        }
      ]
    },
